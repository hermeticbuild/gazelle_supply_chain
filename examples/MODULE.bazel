module(name = "gazelle_supply_chain_example")

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "supply_chain_tools", version = "0.0.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "supply-chain-go", version = "0.0.6")
bazel_dep(name = "gazelle_supply_chain", version = "HEAD")

GIT_COMMIT = "df3e61f82ee285763f3ed5cbfc0fab1fedd976ec"

git_override(
    module_name = "package_metadata",
    commit = GIT_COMMIT,
    remote = "https://github.com/bazel-contrib/supply-chain.git",
    strip_prefix = "metadata",
)

git_override(
    module_name = "supply_chain_tools",
    commit = GIT_COMMIT,
    remote = "https://github.com/bazel-contrib/supply-chain.git",
    strip_prefix = "tools",
)

git_override(
    module_name = "supply-chain-go",
    commit = GIT_COMMIT,
    remote = "https://github.com/bazel-contrib/supply-chain.git",
    strip_prefix = "lib/supplychain-go",
)

local_path_override(
    module_name = "gazelle_supply_chain",
    path = "..",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# BuildBuddy ships its own BUILD files and we keep them. Gazelle runs with only
# the license language (-lang=license), so it just merges one
# package(default_package_metadata = ...) call into each existing BUILD file and
# touches nothing else. The license plugin takes its settings as flags because
# build_directives would overwrite BuildBuddy's root BUILD file:
#   -license_default  - license of every package in the module
#   -license_subtree  - dir=label, a different license for a directory and below
go_deps.gazelle_override(
    build_extra_args = [
        "-lang=license",
        "-license_default=@@//licenses:buildbuddy_mit",
        "-license_subtree=enterprise=@@//licenses:buildbuddy_enterprise",
    ],
    build_file_generation = "on",
    path = "github.com/buildbuddy-io/buildbuddy",
)
use_repo(
    go_deps,
    "com_github_buildbuddy_io_buildbuddy",
)

# go_repository always runs the Gazelle from @bazel_gazelle_go_repository_tools.
# Replace that repo with one built from the same Gazelle plus the license plugin.
gazelle_tools = use_repo_rule("@gazelle_supply_chain//:tools_repo.bzl", "gazelle_tools_with_license")

gazelle_tools(name = "gazelle_with_license")

non_module_deps = use_extension("@gazelle//internal/bzlmod:non_module_deps.bzl", "non_module_deps")

override_repo(
    non_module_deps,
    bazel_gazelle_go_repository_tools = "gazelle_with_license",
)
